# Se validan con Zod en src/app/config/env.ts; nunca se lee import.meta.env fuera de ahí.
# Raíz del monolito (sin /api): la app llama a <VITE_API_URL>/api/<VITE_APP_SLUG>.
VITE_API_URL=https://super-davidyero-backend.onrender.com
# Slug del dominio de esta app en el monolito (src/domains/<slug>/).
VITE_APP_SLUG=template
VITE_DEFAULT_LOCALE=es
