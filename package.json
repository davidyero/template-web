{
  "name": "template-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Plantilla web del ecosistema super-davidyero: Vite + React 19 + @davidyero/ui-web.",
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-i18n.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:barrels": "check-barrels src",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --max-warnings 0"
    ],
    "*.{json,md,css,html,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@davidyero/ui-web": "github:davidyero/super-davidyero-ui-web#v0.20.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.3",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "i18next": "^27.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "~16.1.0",
    "@testing-library/user-event": "~14.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-davidyero": "github:davidyero/eslint-config-davidyero#v0.1.0",
    "husky": "~9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "~3.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "~7.4.1"
  }
}
